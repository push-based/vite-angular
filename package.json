{
  "name": "vite-plugin-ngp-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "prepare": "husky",
    "toolchain": "bash toolchain/build.sh",
    "build": "pnpm -r --filter ./packages/* build",
    "dev": "pnpm build && pnpm --filter playground dev",
    "playground:build": "pnpm build && pnpm --filter playground build",
    "test": "pnpm build && export NGP_TOOLCHAIN=\"${NGP_TOOLCHAIN:-$PWD/toolchain/out}\" && pnpm --filter vite-plugin-ngp test && pnpm --filter playground test && pnpm docs:check",
    "site:dev": "pnpm build && pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build",
    "docs:check": "node site/scripts/check-docs.ts"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "22.3.0-next.2",
    "@angular/compiler-cli": "22.3.0-next.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/config-nx-scopes": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@nx/js": "23.3.0",
    "@types/node": "26.6.5",
    "commitlint-plugin-tense": "1.0.12",
    "husky": "9.1.7",
    "magic-string": "1.4.3",
    "nx": "23.3.0",
    "typescript": "6.0.3"
  }
}
