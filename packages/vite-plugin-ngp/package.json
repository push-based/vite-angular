    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@angular/compiler": "22.3.0-next.2",
    "@angular/compiler-cli": "22.3.0-next.2",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@babel/core": "8.0.7",
    "magic-string": "1.4.3",
    "typescript7": "npm:typescript@7.0.2"
  }
