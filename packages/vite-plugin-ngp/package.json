{
  "name": "vite-plugin-ngp",
  "version": "0.0.0",
  "description": "Vite plugin that compiles Angular with ngp, Angular's hybrid Rust/TypeScript preprocessor",
  "license": "MIT",
  "author": "PushBased",
  "homepage": "https://push-based.github.io/vite-plugin-ngp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/vite-plugin-ngp.git",
    "directory": "packages/vite-plugin-ngp"
  },
  "bugs": {
    "url": "https://github.com/push-based/vite-plugin-ngp/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "angular",
    "ngp",
    "hmr",
    "ssr"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ngp-extract-i18n": "./bin/ngp-extract-i18n.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@angular/compiler": "22.3.0-next.2",
    "@angular/compiler-cli": "22.3.0-next.2",
    "@angular/localize": "22.3.0-next.2",
    "tsrs": ">=0.16.0-0",
    "typescript": ">=6.0 <6.1",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/localize": {
      "optional": true
    },
    "tsrs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "22.3.0-next.2",
    "@angular/compiler-cli": "22.3.0-next.2",
    "@angular/localize": "22.3.0-next.2",
    "@types/node": "26.6.5",
    "tsrs": "0.16.0-ts7.1.0-dev.20260929",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "zone.js": "0.16.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@babel/core": "8.0.7",
    "@jridgewell/remapping": "2.3.5",
    "esbuild": "0.28.2",
    "magic-string": "1.4.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
